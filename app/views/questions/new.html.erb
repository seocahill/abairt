<div class="container mx-auto px-4 py-8 max-w-2xl">
  <h1 class="text-3xl font-bold mb-2">Cuir ceist</h1>
  <p class="text-sm text-gray-500 mb-6">
    Taifead do cheist agus freagróidh cainteoir dúchais í le teachtaireacht ghutha.
  </p>

  <% if @speaker.nil? %>
    <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg p-4">
      Níl aon chainteoir ag glacadh le ceisteanna faoi láthair.
    </div>
  <% else %>
    <%= form_with url: questions_path, method: :post, local: true,
                  class: "bg-white shadow rounded-lg p-6",
                  data: { controller: "audio-recorder direct-upload" } do |form| %>

      <%= form.file_field :audio, hidden: true, direct_upload: true,
                          data: { target: "direct-upload.input" } %>

      <div class="flex flex-wrap gap-3 items-center mb-4">
        <button type="button"
                class="inline-flex items-center px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 disabled:opacity-50"
                data-audio-recorder-target="recordButton"
                data-action="audio-recorder#record">
          Taifead
        </button>

        <button type="button"
                class="inline-flex items-center px-4 py-2 bg-gray-600 text-white text-sm font-medium rounded-lg hover:bg-gray-700 disabled:opacity-50"
                data-audio-recorder-target="stopButton"
                data-action="audio-recorder#stop"
                style="display: none;">
          Stop
        </button>
      </div>

      <p class="text-sm text-gray-600 mb-4">
        Staid: <span data-audio-recorder-target="status">Réidh</span>
        <span class="file-name"></span>
      </p>

      <% if @question.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-800 rounded p-3 mb-4 text-sm">
          <%= @question.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <%= form.submit "Seol chuig #{@speaker.name}",
                      class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
    <% end %>
  <% end %>
</div>
