<div class="max-w-md mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Mo cheisteanna</h1>
    <%= link_to "Cuir ceist", new_question_path,
                class: "px-4 py-2 bg-emerald-800 text-white rounded-lg hover:bg-emerald-900 text-sm" %>
  </div>

  <% if @questions.empty? %>
    <p class="text-gray-500 text-sm">Níl aon cheist curtha agat go fóill.</p>
  <% else %>
    <div id="questions" class="space-y-3">
      <%= render partial: "questions/question", collection: @questions, as: :question %>
    </div>
  <% end %>
</div>
