<div class="container mx-auto px-4 py-8 max-w-3xl">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Mo cheisteanna</h1>
    <%= link_to "Cuir ceist", new_question_path,
                class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm" %>
  </div>

  <% if @questions.empty? %>
    <p class="text-gray-500">Níl aon cheist curtha agat go fóill.</p>
  <% else %>
    <div class="space-y-3">
      <% @questions.each do |question| %>
        <%= link_to question_path(question),
                    class: "block bg-white shadow rounded-lg p-4 hover:bg-gray-50" do %>
          <div class="flex justify-between items-center">
            <div>
              <p class="font-medium"><%= question.speaker.name %></p>
              <p class="text-sm text-gray-500"><%= l question.created_at, format: :short %></p>
            </div>
            <%= render "questions/status", question: question %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
