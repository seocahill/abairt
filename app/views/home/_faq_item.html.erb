<div data-controller="collapse">
  <button type="button" class="flex items-center justify-between w-full py-5 font-medium text-left text-gray-900 border-b border-gray-200 dark:border-gray-700 dark:text-white" data-action="click->collapse#toggle">
    <span><%= question %></span>
    <svg data-collapse-target="icon" class="w-6 h-6 shrink-0" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
  </button>
  <div data-collapse-target="content" class="hidden">
    <div class="py-5 space-y-2 text-gray-500 border-b border-gray-200 dark:border-gray-700 dark:text-gray-400">
      <%= yield %>
    </div>
  </div>
</div>
