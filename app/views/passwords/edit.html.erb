<div class="max-w-md mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold">Socraigh focal faire</h1>
  <p class="text-sm text-gray-500 mt-1 mb-6">
    Le focal faire, is féidir leat síniú isteach ón bhfón gan dul ag lorg nasc sa ríomhphost.
  </p>

  <% if @errors.present? %>
    <div class="bg-red-50 border border-red-200 text-red-800 rounded p-3 mb-4 text-sm">
      <%= @errors.to_sentence %>
    </div>
  <% end %>

  <%= form_with model: current_user, url: password_path, method: :patch, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :password, "Focal faire", class: "block text-sm font-medium text-gray-700" %>
      <%= form.password_field :password, autocomplete: "new-password", required: true,
            class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500" %>
      <p class="text-xs text-gray-400 mt-1">8 gcarachtar ar a laghad.</p>
    </div>

    <div>
      <%= form.label :password_confirmation, "Arís", class: "block text-sm font-medium text-gray-700" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true,
            class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-emerald-500 focus:border-emerald-500" %>
    </div>

    <%= form.submit "Sábháil", class: "w-full px-4 py-2 bg-emerald-800 text-white rounded-md hover:bg-emerald-900 cursor-pointer" %>
  <% end %>
</div>
