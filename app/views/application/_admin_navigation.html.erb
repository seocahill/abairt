<%# Shown on every admin page: one row per group, phone-friendly tap targets. %>
<nav aria-label="Admin" class="bg-gray-800 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 py-2 flex flex-wrap items-center gap-x-6 gap-y-1">
    <%= link_to "Admin", admin_root_path, class: "min-h-12 flex items-center text-sm font-semibold text-white" %>
    <% AdminNavigation.new(current_user).sections.each do |section| %>
      <details class="relative">
        <summary class="min-h-12 flex items-center cursor-pointer text-sm hover:text-white"><%= section.title %></summary>
        <ul class="absolute left-0 z-50 mt-1 w-64 rounded-md bg-white py-1 shadow-lg ring-1 ring-black ring-opacity-5">
          <% section.items.each do |item| %>
            <li><%= link_to item.title, item.path, class: "flex min-h-12 items-center px-4 text-sm text-gray-700 hover:bg-gray-100" %></li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </div>
</nav>
