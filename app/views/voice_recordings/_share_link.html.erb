<%# Copies a link on desktop; opens the share sheet on phones. %>
<button type="button"
        class="flex items-center text-gray-500 hover:text-gray-700 text-sm"
        data-controller="share-link"
        data-action="share-link#share"
        data-share-link-url-value="<%= url %>"
        data-share-link-title-value="<%= title %>"
        data-share-link-label-value="<%= label %>"
        data-share-link-use-current-time-value="<%= local_assigns.fetch(:use_current_time, false) %>">
  <svg class="w-4 h-4 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
    <path d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" />
  </svg>
  <span data-share-link-target="label"><%= label %></span>
</button>
