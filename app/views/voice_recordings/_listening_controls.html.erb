<%# Line-by-line listening controls, shown behind f81_listening_controls. %>
<%# Same shape, icon size (h-4 w-4 filled currentColor) and text size as the Play button in _waveform.html.erb;
    secondary (grey) colour so Play stays the primary action, and a 44px hit area. %>
<% button = "inline-flex items-center justify-center min-w-[44px] min-h-[44px] rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm aria-pressed:bg-blue-600 aria-pressed:text-white aria-pressed:hover:bg-blue-700" %>
<% icon = "h-4 w-4" %>
<div class="relative flex items-center gap-1" role="group" aria-label="Listening controls">
  <button type="button" class="<%= button %>" aria-label="Previous line" title="Previous line (←)"
          data-action="click->waveform#previousLine">
    <svg xmlns="http://www.w3.org/2000/svg" class="<%= icon %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M8.445 14.832A1 1 0 0010 14v-2.798l5.445 3.63A1 1 0 0017 14V6a1 1 0 00-1.555-.832L10 8.798V6a1 1 0 00-1.555-.832l-6 4a1 1 0 000 1.664l6 4z"/></svg>
  </button>
  <button type="button" class="<%= button %>" aria-label="Replay line" title="Replay line (R)"
          data-action="click->waveform#replayLine">
    <svg xmlns="http://www.w3.org/2000/svg" class="<%= icon %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd"/></svg>
  </button>
  <button type="button" class="<%= button %>" aria-label="Loop line" aria-pressed="false" title="Loop line (L)"
          data-waveform-target="loopButton" data-action="click->waveform#toggleLoop">
    <svg xmlns="http://www.w3.org/2000/svg" class="<%= icon %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M8 5a1 1 0 100 2h5.586l-1.293 1.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L13.586 5H8zM12 15a1 1 0 100-2H6.414l1.293-1.293a1 1 0 10-1.414-1.414l-3 3a1 1 0 000 1.414l3 3a1 1 0 001.414-1.414L6.414 15H12z"/></svg>
  </button>
  <button type="button" class="<%= button %>" aria-label="Next line" title="Next line (→)"
          data-action="click->waveform#nextLine">
    <svg xmlns="http://www.w3.org/2000/svg" class="<%= icon %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M4.555 5.168A1 1 0 003 6v8a1 1 0 001.555.832L10 11.202V14a1 1 0 001.555.832l6-4a1 1 0 000-1.664l-6-4A1 1 0 0010 6v2.798l-5.445-3.63z"/></svg>
  </button>
  <button type="button" class="<%= button %>" aria-label="Keyboard shortcuts" title="Keyboard shortcuts"
          data-action="click->waveform#toggleShortcuts">?</button>
  <div data-waveform-target="shortcuts" class="hidden absolute left-0 top-full mt-1 z-20 w-56 rounded-lg border border-gray-200 bg-white p-3 text-xs text-gray-700 shadow-lg">
    <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
      <dt class="font-mono">Space</dt><dd>Play / pause</dd>
      <dt class="font-mono">← →</dt><dd>Previous / next line</dd>
      <dt class="font-mono">R</dt><dd>Replay line</dd>
      <dt class="font-mono">L</dt><dd>Loop line</dd>
      <dt class="font-mono">, .</dt><dd>Slower / faster</dd>
    </dl>
  </div>
</div>
