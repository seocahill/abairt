<div class="container mx-auto px-4 py-6 max-w-2xl">
  <div class="flex items-center justify-between mb-4">
    <%= link_to "← #{@voice_recording.title}", voice_recording_path(@voice_recording), class: "text-blue-600 hover:text-blue-800 min-h-[44px] inline-flex items-center" %>
    <% if @entry %>
      <span class="text-sm text-gray-600" data-testid="check-count"><%= @queue.remaining %> of <%= @queue.total %> left</span>
    <% end %>
  </div>

  <% if flash[:alert] %>
    <p class="mb-3 rounded-sm bg-red-100 text-red-800 px-3 py-2 text-sm"><%= flash[:alert] %></p>
  <% end %>

  <% if @entry %>
    <% audio_url = @entry.media.attached? ? url_for(@entry.media) : (url_for(@voice_recording.media) if @voice_recording.media.attached?) %>
    <div class="bg-white rounded-lg shadow-sm p-4"
         id="dictionary_entry_<%= @entry.id %>"
         data-controller="check"
         data-check-previous-url-value="<%= voice_recording_check_path(@voice_recording, entry_id: @preceding.id) if @preceding %>"
         data-check-next-url-value="<%= voice_recording_check_path(@voice_recording, entry_id: @following.id) if @following %>"
         data-check-exit-url-value="<%= voice_recording_path(@voice_recording) %>"
         data-check-start-value="<%= @entry.media.attached? ? 0 : @entry.region_start.to_f %>"
         data-check-end-value="<%= @entry.media.attached? ? 0 : @entry.region_end.to_f %>">
      <div class="flex items-center gap-3 mb-3">
        <button type="button"
                class="shrink-0 bg-blue-100 text-blue-600 hover:bg-blue-200 p-2 rounded-full transition-colors duration-200 min-w-[44px] min-h-[44px] flex items-center justify-center"
                aria-label="Replay this line" title="Replay (Alt+R)"
                data-action="check#replay">
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
          </svg>
        </button>
        <label class="flex items-center gap-2 text-sm text-gray-700 min-h-[44px]">
          <input type="checkbox" data-check-target="loop" data-action="check#toggleLoop"> Loop
        </label>
        <span class="text-sm text-gray-500"><%= format_duration(@entry.region_start) %> - <%= format_duration(@entry.region_end) %> · <%= @entry.speaker&.name || "No speaker" %></span>
      </div>
      <audio data-check-target="audio" src="<%= audio_url %>" preload="auto"></audio>

      <%= form_with model: @entry, scope: :dictionary_entry, url: voice_recording_check_path(@voice_recording, entry_id: @entry.id), method: :patch, data: {check_target: "form"} do |form| %>
        <div class="space-y-3">
          <%= form.text_area :word_or_phrase, rows: 3, autofocus: true,
              aria_label: "Word or phrase",
              class: "w-full text-lg font-medium border border-gray-300 rounded-sm px-2 py-1 focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-y min-h-12",
              placeholder: "Word or phrase",
              data: {action: "keydown->check#fieldKey"} %>
          <%= form.text_area :translation, rows: 3,
              aria_label: "Translation",
              class: "w-full text-gray-600 border border-gray-300 rounded-sm px-2 py-1 focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-y min-h-12",
              placeholder: "Translation",
              data: {action: "keydown->check#fieldKey"} %>
          <%= form.submit "Confirm and next", class: "w-full bg-blue-600 text-white px-3 py-2 rounded-sm hover:bg-blue-700 transition-colors min-h-[44px]" %>
        </div>
      <% end %>

      <div class="flex gap-2 mt-3">
        <% if @preceding %>
          <%= link_to "Previous", voice_recording_check_path(@voice_recording, entry_id: @preceding.id), class: "flex-1 text-center bg-gray-300 text-gray-700 px-3 py-2 rounded-sm hover:bg-gray-400 transition-colors min-h-[44px] inline-flex items-center justify-center", title: "Previous (Shift+Tab)" %>
        <% end %>
        <% if @following %>
          <%= link_to "Skip", voice_recording_check_path(@voice_recording, entry_id: @following.id), class: "flex-1 text-center bg-gray-300 text-gray-700 px-3 py-2 rounded-sm hover:bg-gray-400 transition-colors min-h-[44px] inline-flex items-center justify-center", title: "Skip without confirming" %>
        <% end %>
      </div>

      <p class="mt-3 text-xs text-gray-500 hidden md:block">Enter confirms and moves on (Shift+Enter for a new line) · Alt+Right / Ctrl+Left skip without confirming · Alt+R replays · Esc leaves</p>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow-sm p-6 text-center">
      <p class="text-lg font-medium text-gray-900">Every line in this recording has been checked.</p>
      <%= link_to "Back to the recording", voice_recording_path(@voice_recording), class: "mt-4 inline-flex items-center justify-center bg-blue-600 text-white px-4 py-2 rounded-sm hover:bg-blue-700 transition-colors min-h-[44px]" %>
    </div>
  <% end %>
</div>
