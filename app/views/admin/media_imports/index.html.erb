<div>
  <%= admin_page_header "Media imports", subtitle: "Manage import queue for voice recordings" do %>
    <%= link_to "New import", new_admin_media_import_path, class: admin_button_class(:primary) %>
    <% if @stats[:pending] > 0 %>
      <%= button_to "Process all pending (#{@stats[:pending]})", process_all_pending_admin_media_imports_path,
          method: :post,
          class: admin_button_class(:positive),
          form: { data: { turbo_confirm: "Queue all #{@stats[:pending]} pending imports?" } } %>
    <% end %>
  <% end %>

  <%= render "admin/search_form", url: admin_media_imports_path, placeholder: "Search by title or URL...",
        keep: {status: params[:status]}, clear_path: admin_media_imports_path(status: params[:status]) %>

  <%# Status filter, with the count in each %>
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <%= admin_filter_link "All (#{@stats[:total]})", admin_media_imports_path(search: params[:search]),
          current: params[:status].blank? %>
    <% MediaImport.statuses.each_key do |status| %>
      <%= admin_filter_link "#{status.humanize} (#{@stats[status.to_sym]})", admin_media_imports_path(status: status, search: params[:search]),
            current: params[:status] == status %>
    <% end %>
  </div>

  <%# Table %>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>URL</th>
          <th>Status</th>
          <th>Updated</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @media_imports.each do |mi| %>
          <tr class="hover:bg-gray-50">
            <td class="font-medium text-gray-900">
              <%= link_to mi.title.truncate(50), admin_media_import_path(mi), class: "text-blue-600 hover:underline" %>
            </td>
            <td class="text-gray-500">
              <%= link_to mi.url.truncate(40), mi.url, target: "_blank", class: "text-gray-500 hover:text-gray-700" %>
            </td>
            <td>
              <% status_colors = { "pending" => "bg-yellow-100 text-yellow-800", "imported" => "bg-green-100 text-green-800", "skipped" => "bg-gray-100 text-gray-800", "failed" => "bg-red-100 text-red-800" } %>
              <span class="px-2 py-1 text-xs font-semibold rounded-full <%= status_colors[mi.status] %>">
                <%= mi.status.humanize %>
              </span>
              <% if mi.failed? && mi.error_message.present? %>
                <div class="mt-1 text-xs text-red-500 max-w-xs truncate" title="<%= mi.error_message %>">
                  <%= mi.error_message.truncate(80) %>
                </div>
              <% end %>
            </td>
            <td class="text-gray-500">
              <%= mi.updated_at.strftime("%Y-%m-%d %H:%M") %>
            </td>
            <td>
              <div class="flex gap-2">
                <% if mi.pending? %>
                  <%= button_to "Process", process_now_admin_media_import_path(mi),
                      method: :post,
                      class: "text-green-600 hover:text-green-900 text-xs" %>
                <% elsif mi.failed? %>
                  <%= button_to "Retry", retry_admin_media_import_path(mi),
                      method: :post,
                      class: "text-amber-600 hover:text-amber-900 text-xs" %>
                <% end %>
                <%= link_to "Edit", edit_admin_media_import_path(mi), class: "text-indigo-600 hover:text-indigo-900 text-xs" %>
                <%= button_to "Delete", admin_media_import_path(mi),
                    method: :delete,
                    class: "text-red-600 hover:text-red-900 text-xs",
                    form: { data: { turbo_confirm: "Delete this import?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Pagination %>
  <% if @pagy.pages > 1 %>
    <div class="mt-6 border-t border-gray-200 pt-6 flex items-center justify-between">
      <div class="text-sm text-gray-700">
        Showing <span class="font-medium"><%= @pagy.from %></span> to
        <span class="font-medium"><%= @pagy.to %></span> of
        <span class="font-medium"><%= @pagy.count %></span> imports
      </div>
      <div class="flex space-x-2">
        <% if @pagy.prev %>
          <%= link_to "Previous", admin_media_imports_path(page: @pagy.prev, status: params[:status], search: params[:search]),
              class: "px-4 py-2 text-sm text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" %>
        <% end %>
        <% if @pagy.next %>
          <%= link_to "Next", admin_media_imports_path(page: @pagy.next, status: params[:status], search: params[:search]),
              class: "px-4 py-2 text-sm text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" %>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
