<div>
  <%= admin_page_header "Training progress",
        subtitle: "Hours of human-checked audio per speaker against placeholder targets (TTS #{@progress[:targets][:tts_hours_per_speaker]} h, ASR #{@progress[:targets][:asr_hours_per_speaker]} h per speaker)." %>

  <section>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr><th>Speaker</th><th>Total h</th><th>Checked h</th><th>Lines to check</th><th>TTS target</th><th>ASR target</th></tr>
        </thead>
        <tbody>
          <% @progress[:speakers].each do |row| %>
            <tr>
              <td class="font-medium"><%= row[:name] %></td>
              <td><%= row[:total_hours] %></td>
              <td><%= row[:checked_hours] %></td>
              <td><%= row[:lines_to_check] %> of <%= row[:lines_total] %></td>
              <% %i[tts_progress_percent asr_progress_percent].each do |key| %>
                <td class="w-40">
                  <div class="h-2 rounded-sm bg-gray-200"><div class="h-2 rounded-sm bg-blue-600" style="width: <%= row[key] %>%"></div></div>
                  <span class="text-xs text-gray-500"><%= row[key] %>%</span>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @progress[:speakers].empty? %><p class="mt-4 text-gray-700">No lines with a speaker yet.</p><% end %>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-semibold text-gray-700 mb-2">Needs human work</h2>
    <p class="text-sm text-gray-500 mb-2">Recordings with the most unchecked lines.</p>
    <% if @progress[:needs_work].empty? %><p class="text-sm text-gray-700">Nothing waiting to be checked.</p><% end %>
    <ul class="text-sm text-gray-700">
      <% @progress[:needs_work].each do |item| %>
        <% recording = @recordings[item[:voice_recording_id]] %>
        <li>
          <%= link_to(recording&.title.presence || "Recording ##{item[:voice_recording_id]}", voice_recording_path(item[:voice_recording_id]), class: "text-blue-700 underline") %>:
          <%= item[:lines_to_check] %> lines
        </li>
      <% end %>
    </ul>
  </section>
</div>
