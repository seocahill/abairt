<div>
  <%= admin_page_header "Questions", subtitle: "Speakers hold one question at a time." %>

  <%# Who is holding what right now %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <% @speakers.each do |speaker| %>
      <% outstanding = QuestionQueue.new(speaker).outstanding %>
      <div class="bg-white shadow-sm rounded-lg p-4">
        <p class="font-medium"><%= speaker.name %></p>
        <p class="text-sm mt-2">
          <% if outstanding %>
            Holding #<%= outstanding.id %> since <%= time_ago_in_words(outstanding.sent_at || outstanding.created_at) %> ago
          <% else %>
            Nothing outstanding
          <% end %>
        </p>
      </div>
    <% end %>
  </div>

  <%# Status filter %>
  <div class="mb-4 flex flex-wrap items-center gap-2">
    <%= admin_filter_link "All (#{@stats.values.sum})", admin_questions_path, current: params[:status].blank? %>
    <% Question.statuses.each_key do |status| %>
      <%= admin_filter_link "#{status.humanize} (#{@stats[status.to_sym] || 0})",
            admin_questions_path(status: status), current: params[:status] == status %>
    <% end %>
  </div>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Asker</th>
          <th>Speaker</th>
          <th>Status</th>
          <th>Asked</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @questions.each do |question| %>
          <tr>
            <td><%= question.id %></td>
            <td><%= question.asker.name %></td>
            <td><%= question.speaker&.name || "—" %></td>
            <td><%= render "questions/status", question: question %></td>
            <td class="text-gray-500"><%= time_ago_in_words(question.created_at) %> ago</td>
            <td>
              <% unless question.answered? %>
                <%= button_to "Check queue", deliver_admin_question_path(question),
                              method: :post,
                              class: admin_button_class(:secondary) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4">
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>
