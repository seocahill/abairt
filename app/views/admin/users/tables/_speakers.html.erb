<%# Speakers never sign in, so no email, status or token here: what matters is
    who they are and whether questions can reach them. %>
<div class="admin-table-wrap mb-4">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Dialect</th>
        <th>Voice</th>
        <th>Questions</th>
        <th>Created</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% users.each do |user| %>
        <tr>
          <td class="whitespace-nowrap font-medium text-gray-900">
            <%= link_to user.name, admin_user_path(user), class: "text-blue-600 hover:text-blue-900" %>
          </td>
          <td class="whitespace-nowrap text-gray-500"><%= user.dialect&.humanize || "Not specified" %></td>
          <td class="whitespace-nowrap text-gray-500"><%= user.voice&.humanize || "Not specified" %></td>
          <td class="whitespace-nowrap">
            <% if !user.telegram_speaker? %>
              <span class="text-gray-400 text-xs">No</span>
            <% elsif user.telegram_chat_id.present? %>
              <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Connected</span>
            <% else %>
              <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Not connected</span>
            <% end %>
          </td>
          <td class="whitespace-nowrap text-gray-500"><%= user.created_at.strftime("%Y-%m-%d") %></td>
          <td class="font-medium">
            <div class="flex flex-col gap-1">
              <%= render "admin/users/delete_button", user: %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
