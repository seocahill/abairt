<div>
  <%= admin_page_header "Users", subtitle: admin_user_kind_description(@kind) do %>
    <% if (label = AdminUsersHelper::NEW_USER_LABELS[@kind]) %>
      <%= link_to label, new_admin_user_path(kind: @kind), class: admin_button_class(:primary) %>
    <% end %>
  <% end %>

  <%# One tab per kind of person; each kind has its own columns and actions. %>
  <nav class="mb-4 flex flex-wrap items-center gap-2" aria-label="Kinds of user">
    <% AdminUsersHelper::KIND_LABELS.each do |kind, label| %>
      <%= admin_filter_link label, admin_users_path(kind: kind), current: @kind == kind %>
    <% end %>
  </nav>

  <%= render "admin/search_form", url: admin_users_path, placeholder: "Search by name or email...",
        keep: {kind: @kind, pending: params[:pending]},
        clear_path: admin_users_path(kind: @kind, pending: params[:pending]) %>

  <% if @kind == "members" %>
    <div class="mb-4 flex flex-wrap items-center gap-2">
      <span class="text-sm text-gray-700 font-medium">Sign-up:</span>
      <%= admin_filter_link "All members", admin_users_path(kind: @kind, search: params[:search]),
            current: params[:pending].blank? %>
      <%= admin_filter_link "Pending sign-ups", admin_users_path(kind: @kind, pending: true, search: params[:search]),
            current: params[:pending] == "true" %>
    </div>
  <% end %>

  <% if @users.load.empty? %>
    <p class="mb-4 text-sm text-gray-500">No one here<%= " matching “#{params[:search]}”" if params[:search].present? %>.</p>
  <% else %>
    <%= render "admin/users/tables/#{@kind.in?(%w[members speakers staff]) ? @kind : "people"}", users: @users %>
  <% end %>

  <% if @pagy.pages > 1 %>
    <% page_params = {kind: @kind, pending: params[:pending], search: params[:search], per_page: params[:per_page]} %>
    <div class="mt-6 border-t border-gray-200 pt-6 flex items-center justify-between">
      <div class="text-sm text-gray-700">
        Showing <span class="font-medium"><%= @pagy.from %></span> to
        <span class="font-medium"><%= @pagy.to %></span> of
        <span class="font-medium"><%= @pagy.count %></span> users
      </div>
      <div class="flex space-x-2">
        <% if @pagy.prev %>
          <%= link_to "Previous", admin_users_path(page: @pagy.prev, **page_params),
              class: "px-4 py-2 text-sm text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" %>
        <% end %>
        <% if @pagy.next %>
          <%= link_to "Next", admin_users_path(page: @pagy.next, **page_params),
              class: "px-4 py-2 text-sm text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
