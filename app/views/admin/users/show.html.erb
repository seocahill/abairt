<div class="max-w-4xl">
  <%= admin_page_header @user.name, back: ["Users", admin_users_path] do %>
    <%= link_to "Edit", edit_admin_user_path(@user), class: admin_button_class(:primary) %>
    <% unless @user.confirmed? %>
      <%= button_to "Approve", approve_admin_user_path(@user), method: :post, class: admin_button_class(:positive) %>
      <%= button_to "Reject", reject_admin_user_path(@user), method: :post, class: admin_button_class(:danger), data: { confirm: "Are you sure? This will delete the user." } %>
    <% end %>
    <%= button_to "Delete", admin_user_path(@user), method: :delete, class: admin_button_class(:danger), data: { confirm: "Are you sure?" } %>
  <% end %>

  <div class="bg-white shadow rounded-lg overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex flex-wrap gap-2">
      <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800"><%= @user.role.humanize %></span>
      <% if @user.confirmed? %>
        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Confirmed</span>
      <% else %>
        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>
      <% end %>
    </div>

    <%# How a Telegram speaker is connected to their chat: send them this, they
        tap it once, and the token tells us who they are. No phone number, no
        typing, nothing for them to read out. %>
    <% if @user.telegram_speaker? %>
      <div class="px-6 py-4 bg-blue-50 border-b border-blue-100">
        <h3 class="text-sm font-medium text-blue-900 mb-1">Telegram</h3>
        <% if @user.telegram_chat_id.present? %>
          <p class="text-sm text-blue-800">Connected. Questions will reach them.</p>
        <% elsif @user.telegram_invite_link %>
          <p class="text-sm text-blue-800 mb-2">
            Not connected yet. Send them this link — one tap connects them, and it stops working once used.
          </p>
          <code class="block text-sm bg-white border border-blue-200 rounded px-3 py-2 break-all"><%= @user.telegram_invite_link %></code>
          <%= button_to "Issue a new link", telegram_invite_admin_user_path(@user), method: :post,
                class: "mt-2 text-sm text-blue-700 underline",
                form: { data: { turbo_confirm: "The link you already sent will stop working." } } %>
        <% elsif @user.bot_username.blank? %>
          <p class="text-sm text-blue-800">
            Not connected, and no link can be built: set <code>telegram.bot_username</code> in credentials.
          </p>
        <% else %>
          <p class="text-sm text-blue-800 mb-2">Not connected, and no invite link yet.</p>
          <%= button_to "Create an invite link", telegram_invite_admin_user_path(@user), method: :post,
                class: "px-3 py-2 bg-blue-600 text-white rounded text-sm hover:bg-blue-700" %>
        <% end %>
      </div>
    <% end %>

    <!-- User Details -->
    <div class="px-6 py-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Left Column -->
        <div class="space-y-6">
          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-1">Email</h3>
            <p class="text-base text-gray-900"><%= @user.email %></p>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-1">About</h3>
            <p class="text-base text-gray-900"><%= @user.about.present? ? @user.about : "Not specified" %></p>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-1">Voice</h3>
            <p class="text-base text-gray-900"><%= @user.voice&.humanize || "Not specified" %></p>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-1">Language Ability</h3>
            <p class="text-base text-gray-900"><%= @user.ability&.humanize || "Not specified" %></p>
          </div>
        </div>

        <!-- Right Column -->
        <div class="space-y-6">
          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-1">Dialect</h3>
            <p class="text-base text-gray-900"><%= @user.dialect&.humanize || "Not specified" %></p>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-1">Location</h3>
            <p class="text-base text-gray-900"><%= @user.address || "Not specified" %></p>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-1">Created</h3>
            <p class="text-base text-gray-900"><%= @user.created_at.strftime("%B %d, %Y at %I:%M %p") %></p>
          </div>

          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-1">Last Updated</h3>
            <p class="text-base text-gray-900"><%= @user.updated_at.strftime("%B %d, %Y at %I:%M %p") %></p>
          </div>
        </div>
      </div>

      <!-- API Token Section -->
      <div class="mt-8 pt-6 border-t border-gray-200">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
          <h3 class="text-lg font-medium text-gray-900">API Token</h3>
          <div class="flex flex-wrap gap-2">
            <% if @user.api_token.present? %>
              <%= button_to "Regenerate Token", regenerate_api_token_admin_user_path(@user), method: :post, class: admin_button_class(:secondary) %>
              <%= button_to "Revoke Token", revoke_api_token_admin_user_path(@user), method: :post, class: admin_button_class(:danger), data: { confirm: "Are you sure?" } %>
            <% else %>
              <%= button_to "Generate Token", generate_api_token_admin_user_path(@user), method: :post, class: admin_button_class(:positive) %>
            <% end %>
          </div>
        </div>
        <% if @user.api_token.present? %>
          <div class="bg-gray-50 rounded-lg p-4">
            <p class="text-sm text-gray-600 mb-2">Token (first 8 characters):</p>
            <code class="bg-white px-3 py-2 rounded border border-gray-300 text-sm font-mono"><%= @user.api_token.first(8) %>...</code>
            <p class="text-xs text-gray-500 mt-2">Full token is stored securely and only shown partially for security.</p>
          </div>
        <% else %>
          <p class="text-sm text-gray-500">No API token has been generated for this user.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

