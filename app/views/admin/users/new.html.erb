<% kind = @user.kind.to_s %>
<div class="max-w-4xl">
  <%= admin_page_header AdminUsersHelper::NEW_USER_LABELS.fetch(kind, "New user"),
        subtitle: (kind == "speakers" ? "A speaker is set up here: a name, a phone number and the box below checked. No email, no password, nothing for them to sign into." : admin_user_kind_description(kind)),
        back: [admin_user_kind_label(kind), admin_users_path(kind: kind)] %>

  <div class="bg-white shadow rounded-lg overflow-hidden">

    <%= render "form", user: @user, submit_label: "Create User" %>
  </div>
</div>
