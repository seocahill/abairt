<%# The top of every admin page; rendered by admin_page_header (AdminPageHelper). %>
<header class="mb-6">
  <% if back %>
    <%= link_to "← #{back.first}", back.last, class: "inline-block mb-2 text-sm text-gray-600 hover:text-gray-900" %>
  <% end %>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <h1 class="text-2xl md:text-3xl font-bold text-gray-900 break-words"><%= title %></h1>
      <% if subtitle.present? %>
        <p class="mt-1 text-sm text-gray-500"><%= subtitle %></p>
      <% end %>
    </div>
    <% if actions.present? %>
      <div class="flex flex-wrap items-center gap-2"><%= actions %></div>
    <% end %>
  </div>
</header>
