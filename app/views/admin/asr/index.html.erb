<div>
  <%= admin_page_header "ASR quality", subtitle: "Word and character error rates (lower is better) on human-checked segments." %>

  <% if @eval_set.nil? %>
    <p class="text-gray-700">No evaluation set yet. Freeze one from the console: <code>AsrEvalSet.freeze_from(name: "mayo")</code></p>
  <% else %>
    <p class="text-sm text-gray-600">
      Set <strong><%= @eval_set.name %> v<%= @eval_set.version %></strong>,
      frozen <%= l @eval_set.frozen_at.to_date %>,
      <%= @eval_set.asr_eval_set_entries.count %> segments.
    </p>

    <% if @runs.empty? %>
      <p class="mt-4 text-gray-700">No runs yet. Score one from the console: <code>AsrEvaluation.new(AsrEvalSet.last, provider: "fotheidil").call</code></p>
    <% else %>
      <section class="mt-6">
        <h2 class="text-lg font-semibold text-gray-700 mb-2">Latest run per provider</h2>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr><th>Provider</th><th>Segments</th><th>WER %</th><th>CER %</th><th>Run</th></tr>
            </thead>
            <tbody>
              <% @runs.each do |run| %>
                <tr>
                  <td class="font-medium"><%= run.provider %></td>
                  <td><%= run.results.dig("overall", "segments") %></td>
                  <td><%= run.results.dig("overall", "wer") || "–" %></td>
                  <td><%= run.results.dig("overall", "cer") || "–" %></td>
                  <td class="text-gray-500"><%= l run.created_at.to_date %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>

      <% %w[by_dialect by_speaker].each do |breakdown| %>
        <section class="mt-8">
          <h2 class="text-lg font-semibold text-gray-700 mb-2"><%= breakdown == "by_dialect" ? "By dialect" : "By speaker" %></h2>
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr><th><%= breakdown == "by_dialect" ? "Dialect" : "Speaker" %></th><th>Provider</th><th>Segments</th><th>WER %</th><th>CER %</th></tr>
              </thead>
              <tbody>
                <% @runs.each do |run| %>
                  <% run.results[breakdown].to_h.each do |name, row| %>
                    <tr>
                      <td><%= breakdown == "by_dialect" ? name.to_s.humanize : name %></td>
                      <td><%= run.provider %></td>
                      <td><%= row["segments"] %></td>
                      <td><%= row["wer"] || "–" %></td>
                      <td><%= row["cer"] || "–" %></td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <section class="mt-8">
        <h2 class="text-lg font-semibold text-gray-700 mb-2">Trend</h2>
        <ul class="text-sm text-gray-700">
          <% @trend.each do |run| %>
            <li><%= l run.created_at.to_date %> · <%= run.provider %> · WER <%= run.results.dig("overall", "wer") || "–" %>% · CER <%= run.results.dig("overall", "cer") || "–" %>%</li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>

  <section class="mt-8">
    <h2 class="text-lg font-semibold text-gray-700 mb-2">Segments that qualify as ground truth now</h2>
    <p class="text-sm text-gray-500 mb-2">Confirmed by a human, with audio. Total <%= @candidates.values.sum %>.</p>
    <ul class="text-sm text-gray-700">
      <% @candidates.each do |speaker, count| %>
        <li><%= speaker.presence || "Unnamed" %>: <%= count %></li>
      <% end %>
    </ul>
  </section>
</div>
