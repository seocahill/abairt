<div class="max-w-2xl">
  <%= admin_page_header "Seol Ríomhphost chuig na hÚsáideoirí", back: ["Siar", admin_emails_path] %>

  <div class="bg-white shadow-sm rounded-lg p-6">
    <%= form_with model: @email, url: admin_emails_path, method: :post, local: true, class: "space-y-6" do |form| %>
      <div>
        <%= form.label :subject, "Ábhar:", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :subject, 
              class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-xs focus:outline-hidden focus:ring-blue-500 focus:border-blue-500",
              placeholder: "Cuir ábhar an ríomhphoist anseo..." %>
      </div>

      <div class="flex-1 flex flex-col">
        <%= form.label :rich_content, "Teachtaireacht:", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <div class="flex-1">
          <%= form.rich_text_area :rich_content, 
                class: "w-full border border-gray-300 rounded-md shadow-xs focus:outline-hidden focus:ring-blue-500 focus:border-blue-500 prose prose-sm max-w-none",
                style: "min-height: 400px;" %>
        </div>
      </div>

      <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
        <div class="flex">
          <div class="ml-3">
            <h3 class="text-sm font-medium text-yellow-800">
              Rabhadh
            </h3>
            <div class="mt-2 text-sm text-yellow-700">
              <p>Seolfar an ríomhphost seo chuig gach úsáideoir gníomhach sa chóras (<%= User.active.count %> úsáideoir).</p>
            </div>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-2">
        <%= link_to "Cealaigh", admin_emails_path, class: admin_button_class(:secondary) %>
        <%= form.submit "Cruthaigh Dréacht", 
              class: admin_button_class(:primary) %>
      </div>
    <% end %>
  </div>
</div>
