<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type">
  </head>
  <body>
    <h1>Sign in to the Abairt app</h1>
    <p>Hello <%= @user.email %>,
      <%= link_to "open this link on your phone to sign in to the Abairt app.", @link %>
